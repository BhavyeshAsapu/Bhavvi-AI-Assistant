# =============================================================================
# Git Ignore — Bhavvi AI Assistant
# =============================================================================

# ---- Environment / Secrets --------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ---- Node / Frontend --------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ---- Uploads / Data ---------------------------------------------------------
backend/uploads/*
!backend/uploads/.gitkeep
backend/vectorstore/chroma_db/
backend/logs/*.log

# ---- IDE / OS ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
