# =============================================================================
# Bhavvi AI Assistant — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# App metadata (used for SEO and branding)
VITE_APP_NAME="Bhavvi AI Assistant"
VITE_APP_DESCRIPTION="A multi-agent multimodal AI assistant powered by Gemini"
VITE_APP_VERSION="1.0.0"
